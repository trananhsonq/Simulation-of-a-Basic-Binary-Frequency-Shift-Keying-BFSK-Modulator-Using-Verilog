module bfsk_modulator (
    input wire clk,       // Xung clock hệ thống (ví dụ: 50MHz)
    input wire rst,       // Tín hiệu reset kích hoạt mức cao (1 = reset)
    input wire data_in,   // Dữ liệu số nhị phân đầu vào (0 hoặc 1)
    output reg fsk_out    // Tín hiệu BFSK ngõ ra sau điều chế
);
    // Khai báo các bộ đếm để chia tần số
    reg [3:0] counter0;
    reg [3:0] counter1;
    
    // Khai báo các đường xung nội bộ đại diện cho bit 0 và bit 1
    reg clk_f0; // Tần số thấp (Đại diện cho bit 0)
    reg clk_f1; // Tần số cao  (Đại diện cho bit 1)

    // Khối tạo tần số clk_f0 (Chia xung clk chính cho 8)
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            counter0 <= 0;
            clk_f0   <= 0;
        end else begin
            if (counter0 == 3) begin
                counter0 <= 0;
                clk_f0   <= ~clk_f0; // Đảo trạng thái xung
            end else begin
                counter0 <= counter0 + 1;
            end
        end
    end

    // Khối tạo tần số clk_f1 (Chia xung clk chính cho 4 -> Nhanh gấp đôi clk_f0)
    always @(posedge clk or posedge rst) begin
        if (rst) begin
            counter1 <= 0;
            clk_f1   <= 0;
        end else begin
            if (counter1 == 1) begin
                counter1 <= 0;
                clk_f1   <= ~clk_f1; // Đảo trạng thái xung nhanh hơn
            end else begin
                counter1 <= counter1 + 1;
            end
        end
    end

    // Khối Multiplexer (Bộ chọn kênh) dựa vào dữ liệu data_in
    always @(*) begin
        if (data_in == 1'b1) begin
            fsk_out = clk_f1; // Nếu dữ liệu là 1 -> Xuất tần số cao
        end else begin
            fsk_out = clk_f0; // Nếu dữ liệu là 0 -> Xuất tần số thấp
        end
    end

endmodule
